<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Dual boot: achar o Windows, reiniciar nele, entrada no menu de boot, relógio local e
     partições NTFS só leitura ou graváveis. Sem senha na sessão ativa; o programa só aceita isso. -->
<policyconfig>
  <vendor>Nyxz</vendor>
  <action id="org.nyxz.dualboot">
    <description>Manage Windows dual boot</description>
    <description xml:lang="pt_BR">Convivência com o Windows: menu de boot, relógio e partições NTFS</description>
    <message>Authentication is required to manage dual boot</message>
    <message xml:lang="pt_BR">É preciso autenticar para mudar a convivência com o Windows</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/nyxz/nyxz-dualboot-root</annotate>
  </action>
</policyconfig>
