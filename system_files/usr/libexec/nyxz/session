#!/usr/bin/bash
# Inicia a sessão da Nyxz. Com o uwsm, cada app roda no seu próprio escopo do systemd,
# que é a base das Estatísticas, da VPN por app e de outras funções (ARQUITETURA.md, 2.1).
#
# O nome do arquivo de sessão muda conforme o pacote do Hyprland (o COPR atual instala
# só "hyprland-uwsm.desktop"), então o Hyprland é iniciado pelo executável.

# Configuração da Nyxz no lugar certo (o Hyprland 0.57 só aceita Lua).
/usr/libexec/nyxz/hypr-config

# VirtualBox/VMware (placa vmwgfx): apps GTK4 com OpenGL acelerado (ex.: Ghostty)
# são desconectados pelo Hyprland ("Error flushing display: Broken pipe"). Nessas
# VMs o OpenGL dos apps vai por software. No PC real nada muda. O uwsm leva esta
# variável para todos os apps da sessão.
case "$(systemd-detect-virt 2>/dev/null)" in
  oracle|vmware) export LIBGL_ALWAYS_SOFTWARE=1 ;;
esac

# Apps Qt (Dolphin…) com o tema escuro e os ícones do kdeglobals
[ -e /usr/lib64/qt6/plugins/platformthemes/KDEPlasmaPlatformTheme6.so ] && export QT_QPA_PLATFORMTHEME=kde

hyprland_cmd="Hyprland"
command -v start-hyprland >/dev/null 2>&1 && hyprland_cmd="start-hyprland"

if command -v uwsm >/dev/null 2>&1; then
  exec uwsm start -D Hyprland -N Hyprland -- "$hyprland_cmd"
fi
exec "$hyprland_cmd"
