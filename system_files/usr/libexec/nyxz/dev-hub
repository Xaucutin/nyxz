#!/usr/bin/bash
# Abre o Dev Hub da Nyxz, opcionalmente numa página:
#   dev-hub [bancos|portas|ssh|cofre]
# Se já estiver aberto, só troca de página.
pagina="${1:-}"
if qs -c nyxz-dev ipc show >/dev/null 2>&1; then
  [ -n "$pagina" ] && qs -c nyxz-dev ipc call devhub abrir "$pagina"
  exit 0
fi
if systemd-detect-virt --quiet 2>/dev/null; then
  export QT_QUICK_BACKEND=software
fi
if [ -n "$pagina" ]; then
  ( sleep 1.5; qs -c nyxz-dev ipc call devhub abrir "$pagina" >/dev/null 2>&1 ) &
fi
exec qs -c nyxz-dev
