def destravar(senha):
    """Destrava o chaveiro com a senha digitada na página (sem a janela do gcr).

    A sessão "plain" do Secret Service vale só para a conexão que a abriu, então a
    abertura e o destravamento precisam sair do mesmo processo (por isso o Gio)."""
    try:
        import gi
        gi.require_version("Gio", "2.0")
        from gi.repository import Gio, GLib
    except (ImportError, ValueError):
        sys.exit("Falta o pacote python3-gobject-base nesta versão.")
    bus = Gio.bus_get_sync(Gio.BusType.SESSION)

    def chamar(interface, metodo, parametros, tipo=None):
        return bus.call_sync("org.freedesktop.secrets", "/org/freedesktop/secrets", interface, metodo, parametros,
                             GLib.VariantType(tipo) if tipo else None, Gio.DBusCallFlags.NONE, 15000, None)

    sessao = chamar("org.freedesktop.Secret.Service", "OpenSession",
                    GLib.Variant("(sv)", ("plain", GLib.Variant("s", ""))), "(vo)").unpack()[1]
    try:
        chamar("org.gnome.keyring.InternalUnsupportedGuiltRiddenInterface", "UnlockWithMasterPassword",
               GLib.Variant("(o(oayays))", ("/org/freedesktop/secrets/collection/login",
                                            (sessao, b"", senha.encode(), "text/plain"))))
    except GLib.Error as e:
        if "Denied" in e.message or "invalid" in e.message:
            sys.exit("Senha errada. Use a senha que o computador tinha quando o chaveiro foi criado.")
        sys.exit("Não deu para destravar: " + e.message)


def consertar(id_, arg):
    simples = {
        "som-reiniciar": ["systemctl", "--user", "restart", "pipewire.service", "pipewire-pulse.service", "wireplumber.service"],
        "som-desmutar": ["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "0"],
        "som-volume": ["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", "0.4"],
        "rede-reiniciar": ["pkexec", ROOT, "rede-reiniciar"],
        "dns-limpar": ["pkexec", ROOT, "dns-limpar"],
        "dns-automatico": ["/usr/libexec/nyxz/rede", "dns", "automatico"],
        "rede-reaplicar": ["pkexec", "/usr/libexec/nyxz/nyxz-net-root", "aplicar"],
        "netd-ligar": ["pkexec", "/usr/libexec/nyxz/nyxz-net-root", "netd", "ligar"],
        "ntp-ligar": ["timedatectl", "set-ntp", "true"],
        "flatpak-reparar": ["flatpak", "repair", "--user"],
        "flathub": ["flatpak", "remote-add", "--user", "--if-not-exists", "flathub", "https://dl.flathub.org/repo/flathub.flatpakrepo"],
        "chaveiro-conectar": ["gnome-keyring-daemon", "--start", "--components=secrets"],
    }
    if id_ in simples:
        c, s, e = rodar(simples[id_], timeout=300)
    elif id_ == "chaveiro-destravar":
        destravar(sys.stdin.read())
        return
    elif id_ == "reiniciar-usuario" and arg and UNIDADE.match(arg):
        rodar(["systemctl", "--user", "reset-failed", arg])
        c, s, e = rodar(["systemctl", "--user", "restart", arg], timeout=60)
    elif id_ == "reiniciar-sistema" and arg and UNIDADE.match(arg):
        c, s, e = rodar(["pkexec", ROOT, "reiniciar", arg], timeout=90)
    elif id_ == "limpeza":
        subprocess.Popen(["/usr/libexec/nyxz/dev-hub", "limpeza"], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return
    else:
        sys.exit("Conserto desconhecido.")
    if c != 0:
        sys.exit((e or s).strip()[-300:] or "Não deu certo.")


