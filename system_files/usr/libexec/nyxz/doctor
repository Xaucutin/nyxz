def anonimizar(t, extras):
    t = t.replace(str(CASA), "~")
    for valor, troca in extras:
        if valor and len(valor) >= 3:
            t = re.sub(r"(?<![\w-])" + re.escape(valor) + r"(?![\w-])", troca, t)
    t = re.sub(r"[\w.+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}\b", "<e-mail>", t)
    t = re.sub(r"\b([0-9a-fA-F]{2}[:-]){5}[0-9a-fA-F]{2}\b", "<mac>", t)
    t = re.sub(r"\b(?!127\.0\.0\.1\b)(\d{1,3}\.){3}\d{1,3}\b", "<ip>", t)
    t = re.sub(r"\b([0-9a-fA-F]{1,4}:){3,7}[0-9a-fA-F]{1,4}\b", "<ip>", t)
    return t


def relatorio():
    usuario = getpass.getuser()
    nome_real = pwd.getpwuid(os.getuid()).pw_gecos.split(",")[0]
    extras = [(usuario, "<usuário>")]
    # Nomes de computador padrão (nyxz, fedora…) não identificam ninguém e apagariam "Nyxz" do texto
    if socket.gethostname().lower() not in ("nyxz", "fedora", "localhost", "localhost-live"):
        extras.append((socket.gethostname(), "<computador>"))
    extras += [(p, "<usuário>") for p in nome_real.split() if len(p) >= 4]
    try:
        extras.append((Path("/etc/machine-id").read_text().strip(), "<id>"))
    except OSError:
        pass
    for d in (ler_json("/var/lib/nyxz/discos.json", {}) or {}).get("discos", []):
        extras.append((d.get("serie", ""), "<série>"))
    extras.sort(key=lambda x: -len(x[0] or ""))

    def secao(titulo, texto):
        return f"\n== {titulo}\n{texto.strip()}\n"

    os_rel = dict(l.split("=", 1) for l in Path("/usr/lib/os-release").read_text().splitlines() if "=" in l)
    cpu = next((l.split(":", 1)[1].strip() for l in Path("/proc/cpuinfo").read_text().splitlines() if l.startswith("model name")), "")
    _, gpus, _ = rodar(["sh", "-c", "lspci -nn | grep -Ei 'vga|3d|display'"])
    _, discos, _ = rodar(["lsblk", "-d", "-o", "NAME,MODEL,SIZE,ROTA,TRAN"])
    _, telas, _ = rodar(["hyprctl", "monitors"])
    telas = "\n".join(l for l in telas.splitlines() if re.match(r"^(Monitor|\s+(\d+x\d+@|description|make|model|scale|vrr))", l))
    _, hypr, _ = rodar(["hyprctl", "version"])
    _, qs, _ = rodar(["qs", "--version"])
    _, ostree, _ = rodar(["rpm-ostree", "status"])
    total = int(Path("/proc/meminfo").read_text().split()[1]) * 1024

    estados = {"ok": "OK   ", "aviso": "AVISO", "erro": "ERRO "}
    linhas = [f"[{estados[i['estado']]}] {i['area']} · {i['titulo']}: {i['texto']}" for i in verificar()]
    _, err_sis, _ = rodar(["journalctl", "-b", "-p", "err", "-n", "60", "--no-pager", "-o", "short"])
    _, err_usu, _ = rodar(["journalctl", "--user", "-b", "-p", "err", "-n", "40", "--no-pager", "-o", "short"])

    texto = (f"Relatório do Nyxz Doctor, gerado em {datetime.datetime.now():%d/%m/%Y às %H:%M}.\n"
             "Nomes de usuário e do computador, IPs, endereços MAC, e-mails e números de série foram removidos.\n"
             + secao("Sistema", f"{os_rel.get('PRETTY_NAME', '').strip(chr(34))}\n"
                                f"Kernel: {os.uname().release}\nProcessador: {cpu}\nMemória: {gb(total)}\n"
                                f"Hyprland: {hypr.splitlines()[0] if hypr else '?'}\nQuickshell: {qs.strip() or '?'}")
             + secao("Placas de vídeo", gpus)
             + secao("Discos", discos)
             + secao("Telas", telas)
             + secao("Versões do sistema (rpm-ostree)", ostree)
             + secao("Verificações", "\n".join(linhas))
             + secao("Erros recentes do sistema (este boot)", err_sis or "nenhum")
             + secao("Erros recentes da sessão (este boot)", err_usu or "nenhum"))
    texto = anonimizar(texto, extras)
    pasta = rodar(["xdg-user-dir", "DOCUMENTS"])[1].strip()
    pasta = Path(pasta) if pasta and Path(pasta).is_dir() and Path(pasta) != CASA else CASA
    destino = pasta / f"Nyxz-diagnostico-{datetime.date.today().isoformat()}.txt"
    destino.write_text(texto, encoding="utf-8")
    print(destino)


