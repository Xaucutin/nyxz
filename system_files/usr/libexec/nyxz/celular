#!/usr/bin/python3 -I
# Celular integrado (ideia 21) pelo KDE Connect: notificações do celular no PC, área de
# transferência compartilhada, arquivos nos dois sentidos, controle de mídia e achar o
# celular. O kdeconnectd só roda quando ligado (serviço do usuário nyxz-celular).
#
#   celular estado                  JSON: instalado, ligado, aparelhos (pareado, alcançável, bateria)
#   celular ligar|desligar
#   celular parear|desparear|tocar|ping <id>
#   celular enviar <id> <arquivo>   manda um arquivo (ou link) para o celular
#   celular texto <id>              manda o texto da entrada padrão (vira a área de transferência lá)
import json
import os
import re
import shutil
import subprocess
import sys

UNIDADE = "nyxz-celular.service"


def rodar(cmd, timeout=20, entrada=None):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, input=entrada,
                           env={**os.environ, "LC_ALL": "C.UTF-8"})
        return r.returncode, r.stdout, r.stderr
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, "", str(e)


def ligado():
    return rodar(["systemctl", "--user", "is-active", UNIDADE])[1].strip() == "active"


def bateria(id_):
    c, s, _ = rodar(["busctl", "--user", "get-property", "org.kde.kdeconnect",
                     f"/modules/kdeconnect/devices/{id_}/battery", "org.kde.kdeconnect.device.battery", "charge"], timeout=5)
    m = re.search(r"i (-?\d+)", s) if c == 0 else None
    return int(m.group(1)) if m and int(m.group(1)) >= 0 else None


def estado():
    instalado = shutil.which("kdeconnect-cli") is not None
    ativo = instalado and ligado()
    aparelhos = []
    if ativo:
        _, s, _ = rodar(["kdeconnect-cli", "--list-devices"])
        # "- Galaxy S21: 1a2b3c (paired and reachable)"
        for l in s.splitlines():
            m = re.match(r"^- (.+): ([\w-]+) \((.+)\)$", l.strip())
            if not m:
                continue
            situacao = m.group(3)
            pareado = "paired" in situacao and "not paired" not in situacao
            alcancavel = "reachable" in situacao and "not reachable" not in situacao
            aparelhos.append({"nome": m.group(1), "id": m.group(2), "pareado": pareado, "alcancavel": alcancavel,
                              "pedindo": "requested" in situacao,
                              "bateria": bateria(m.group(2)) if pareado and alcancavel else None})
    print(json.dumps({"instalado": instalado, "ligado": ativo, "aparelhos": aparelhos}, ensure_ascii=False))


def cli(*args):
    c, s, e = rodar(["kdeconnect-cli", *args], timeout=30)
    if c != 0:
        sys.exit((e or s).strip()[-200:] or "O celular não respondeu.")


def main():
    a = sys.argv[1:]
    if not a or a[0] == "estado":
        estado()
    elif a == ["ligar"]:
        if not shutil.which("kdeconnect-cli"):
            sys.exit("O KDE Connect não está instalado. Instale em Apps e componentes → Celular integrado.")
        rodar(["systemctl", "--user", "enable", "--now", UNIDADE])
        rodar(["kdeconnect-cli", "--refresh"])
    elif a == ["desligar"]:
        rodar(["systemctl", "--user", "disable", "--now", UNIDADE])
        rodar(["pkill", "-x", "kdeconnectd"])
    elif len(a) == 2 and a[0] in ("parear", "desparear", "tocar", "ping"):
        opcao = {"parear": "--pair", "desparear": "--unpair", "tocar": "--ring", "ping": "--ping"}[a[0]]
        cli("-d", a[1], opcao)
    elif len(a) == 3 and a[0] == "enviar":
        alvo = a[2] if re.match(r"^https?://", a[2]) else os.path.abspath(os.path.expanduser(a[2]))
        if not alvo.startswith("http") and not os.path.exists(alvo):
            sys.exit("Arquivo não encontrado.")
        cli("-d", a[1], "--share", alvo)
    elif len(a) == 2 and a[0] == "texto":
        cli("-d", a[1], "--share-text", sys.stdin.read())
    else:
        sys.exit("uso: celular estado|ligar|desligar|parear|desparear|tocar|ping <id>|enviar <id> <arquivo>|texto <id>")


if __name__ == "__main__":
    main()
