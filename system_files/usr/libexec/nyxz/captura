#!/usr/bin/python3 -I
# Captura de tela da Nyxz (ideias 7 e 8). Nada fica rodando: cada atalho chama isto.
#
#   captura area|tela|janela [--editar]   salva em ~/Imagens/Capturas, copia e avisa
#   captura editar <arquivo>              anotar, setas, texto, desfocar (satty)
#   captura texto                         copia o texto de um pedaço da tela (OCR, pt + en)
#   captura cor                           conta-gotas: copia a cor em HEX (mostra RGB e HSL)
#   captura regua                         mede um retângulo na tela em pixels
#   captura gravar area|tela [--gif]      grava vídeo (ou GIF); chamar de novo para parar
#   captura parar
#
# Atalhos: Print (área), Shift+Print (tela), Super+Shift+S (área e editar),
# Super+Shift+T (texto), Super+Shift+C (cor), Super+Shift+M (régua), Super+Shift+R (gravar).
import colorsys
import datetime
import json
import os
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

CASA = Path.home()
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
GRAVANDO = RUNTIME / "nyxz-gravando.json"


def pasta(tipo):
    try:
        base = subprocess.run(["xdg-user-dir", tipo], capture_output=True, text=True).stdout.strip()
    except OSError:
        base = ""
    base = Path(base) if base and Path(base) != CASA else CASA / ("Imagens" if tipo == "PICTURES" else "Vídeos")
    destino = base / ("Capturas" if tipo == "PICTURES" else "Gravações")
    destino.mkdir(parents=True, exist_ok=True)
    return destino


def agora():
    return datetime.datetime.now().strftime("%Y-%m-%d %H-%M-%S")


def avisar(titulo, texto, icone="camera-photo", arquivo=None, acoes=None):
    """Aviso com ações (rodam num processo à parte, sem travar o atalho)."""
    cmd = ["notify-send", "-a", "Nyxz", "-i", str(icone), titulo, texto]
    if not acoes:
        subprocess.run(cmd, check=False)
        return
    for chave, rotulo in acoes:
        cmd[1:1] = ["-A", f"{chave}={rotulo}"]
    if os.fork() == 0:
        os.setsid()
        nulo = os.open(os.devnull, os.O_RDWR)
        for fd in (0, 1, 2):
            os.dup2(nulo, fd)
        escolha = subprocess.run(cmd, capture_output=True, text=True).stdout.strip()
        if escolha == "editar" and arquivo:
            editar(arquivo)
        elif escolha == "abrir" and arquivo:
            subprocess.Popen(["xdg-open", str(arquivo)])
        elif escolha == "pasta" and arquivo:
            subprocess.Popen(["xdg-open", str(Path(arquivo).parent)])
        os._exit(0)


def precisa(*programas):
    falta = [p for p in programas if not shutil.which(p)]
    if falta:
        avisar("Captura indisponível", "Falta nesta versão: " + ", ".join(falta), "dialog-warning")
        sys.exit(1)


def selecionar(*extra):
    """Área escolhida com o mouse (Esc cancela)."""
    if os.environ.get("NYXZ_CAPTURA_AREA"):        # testes automáticos
        return os.environ["NYXZ_CAPTURA_AREA"]
    r = subprocess.run(["slurp", *extra], capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.strip():
        sys.exit(0)   # cancelado
    return r.stdout.strip()


def geometria_janela():
    try:
        j = json.loads(subprocess.run(["hyprctl", "-j", "activewindow"], capture_output=True, text=True).stdout)
        return f"{j['at'][0]},{j['at'][1]} {j['size'][0]}x{j['size'][1]}"
    except (ValueError, KeyError, OSError):
        return None


def copiar_texto(dados):
    # O wl-copy fica em segundo plano servindo a área de transferência: sem herdar a saída
    subprocess.run(["wl-copy"], input=dados, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


def copiar_imagem(arquivo):
    with open(arquivo, "rb") as f:
        subprocess.run(["wl-copy", "--type", "image/png"], stdin=f, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


def capturar(modo, editar_depois):
    precisa("grim", "wl-copy")
    arquivo = pasta("PICTURES") / f"Captura {agora()}.png"
    if modo == "area":
        precisa("slurp")
        geo = selecionar()
        cmd = ["grim", "-g", geo, str(arquivo)]
    elif modo == "janela":
        geo = geometria_janela()
        cmd = ["grim", *(["-g", geo] if geo else []), str(arquivo)]
    else:
        cmd = ["grim", str(arquivo)]
    if subprocess.run(cmd).returncode != 0:
        avisar("A captura falhou", "Não deu para capturar a tela.", "dialog-warning")
        sys.exit(1)
    copiar_imagem(arquivo)
    if editar_depois:
        editar(arquivo)
        return
    avisar("Captura copiada", f"Salva em {arquivo.parent.name}/{arquivo.name}", arquivo, arquivo=arquivo,
           acoes=[("editar", "Editar"), ("pasta", "Abrir a pasta")])


def editar(arquivo):
    if shutil.which("satty"):
        # Salva por cima do mesmo arquivo e copia ao terminar
        subprocess.Popen(["satty", "--filename", str(arquivo), "--output-filename", str(arquivo),
                          "--copy-command", "wl-copy", "--early-exit", "--initial-tool", "arrow"],
                         start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    elif shutil.which("swappy"):
        subprocess.Popen(["swappy", "-f", str(arquivo), "-o", str(arquivo)], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        subprocess.Popen(["xdg-open", str(arquivo)], start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def texto():
    precisa("grim", "slurp", "tesseract", "wl-copy")
    geo = selecionar()
    img = subprocess.run(["grim", "-g", geo, "-s", "2", "-"], capture_output=True).stdout   # 2x: lê melhor letra pequena
    idiomas = subprocess.run(["tesseract", "--list-langs"], capture_output=True, text=True).stdout.split()
    lang = "+".join(l for l in ("por", "eng") if l in idiomas) or "eng"
    r = subprocess.run(["tesseract", "stdin", "stdout", "-l", lang, "--psm", "6"], input=img, capture_output=True)
    lido = r.stdout.decode("utf-8", "replace").strip()
    if not lido:
        avisar("Nenhum texto encontrado", "Tente selecionar uma área com o texto mais nítido.", "edit-find")
        return
    copiar_texto(lido.encode())
    resumo = lido if len(lido) <= 120 else lido[:117] + "…"
    avisar("Texto copiado", resumo, "edit-copy")


def cor():
    precisa("grim", "slurp", "wl-copy")
    ponto = selecionar("-p", "-b", "#00000000")
    r = subprocess.run(["grim", "-g", ponto.split()[0] + " 1x1", "-t", "ppm", "-"], capture_output=True).stdout
    try:
        # PPM: "P6\n1 1\n255\n" + 3 bytes
        rgb = r[-3:]
        cr, cg, cb = rgb[0], rgb[1], rgb[2]
    except IndexError:
        sys.exit(1)
    hexa = f"#{cr:02X}{cg:02X}{cb:02X}"
    h, l, s = colorsys.rgb_to_hls(cr / 255, cg / 255, cb / 255)
    hsl = f"hsl({round(h * 360)}, {round(s * 100)}%, {round(l * 100)}%)"
    copiar_texto(hexa.encode())
    # Ícone com a própria cor
    icone = RUNTIME / "nyxz-cor.ppm"
    icone.write_bytes(b"P6\n48 48\n255\n" + bytes([cr, cg, cb]) * 48 * 48)
    avisar(f"Cor {hexa} copiada", f"rgb({cr}, {cg}, {cb})  ·  {hsl}", icone)


def regua():
    precisa("slurp")
    geo = selecionar("-d")       # -d mostra o tamanho enquanto arrasta
    pos, tam = geo.split()
    w, h = tam.split("x")
    copiar_texto(f"{w}x{h}".encode())
    avisar(f"{w} × {h} px", f"A partir de {pos.replace(',', ', ')}. Copiado.", "measure")


def gravar(modo, gif):
    if GRAVANDO.exists():
        parar()
        return
    precisa("wf-recorder")
    if gif:
        precisa("ffmpeg")
    destino = pasta("VIDEOS") / f"Gravação {agora()}.mp4"
    cmd = ["wf-recorder", "-f", str(destino)]
    if modo == "area":
        precisa("slurp")
        cmd += ["-g", selecionar()]
    # Sem som por padrão (o --audio do wf-recorder grava o microfone)
    p = subprocess.Popen(cmd, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    GRAVANDO.write_text(json.dumps({"pid": p.pid, "arquivo": str(destino), "gif": gif, "inicio": time.time()}))
    avisar("Gravando a tela", "Aperte Super+Shift+R de novo para parar.", "media-record")


def parar():
    try:
        g = json.loads(GRAVANDO.read_text())
    except (OSError, ValueError):
        return
    GRAVANDO.unlink(missing_ok=True)
    try:
        os.kill(g["pid"], signal.SIGINT)
    except OSError:
        pass
    arquivo = Path(g["arquivo"])
    for _ in range(50):          # espera o arquivo ser fechado
        try:
            os.kill(g["pid"], 0)
            time.sleep(0.1)
        except OSError:
            break
    if g.get("gif") and arquivo.exists():
        gif = arquivo.with_suffix(".gif")
        filtro = "fps=15,scale='min(960,iw)':-1:flags=lanczos,split[a][b];[a]palettegen[p];[b][p]paletteuse"
        subprocess.run(["ffmpeg", "-loglevel", "error", "-y", "-i", str(arquivo), "-vf", filtro, str(gif)])
        if gif.exists():
            arquivo.unlink()
            arquivo = gif
    avisar("Gravação salva", f"{arquivo.parent.name}/{arquivo.name}", "video-x-generic", arquivo=arquivo,
           acoes=[("abrir", "Abrir"), ("pasta", "Abrir a pasta")])


def main():
    a = sys.argv[1:]
    if a and a[0] in ("area", "tela", "janela"):
        capturar(a[0], "--editar" in a)
    elif a[:1] == ["editar"] and len(a) == 2:
        editar(Path(a[1]))
    elif a == ["texto"]:
        texto()
    elif a == ["cor"]:
        cor()
    elif a == ["regua"]:
        regua()
    elif a[:1] == ["gravar"]:
        gravar(a[1] if len(a) > 1 and a[1] in ("area", "tela") else "tela", "--gif" in a)
    elif a == ["parar"]:
        parar()
    else:
        sys.exit("uso: captura area|tela|janela [--editar]|editar <arquivo>|texto|cor|regua|gravar area|tela [--gif]|parar")


if __name__ == "__main__":
    main()
