#!/usr/bin/python3 -I
# Automações (ideia 23, estilo Atalhos do iPhone): "quando acontecer X, faça Y".
# Quem percebe os gatilhos é o próprio shell (Automacoes.qml, sem serviço extra); este
# comando guarda as automações e executa as ações.
#
#   automacoes listar              JSON: automações, modelos, opções (perfis, VPNs…) e histórico
#   automacoes salvar              uma automação em JSON pela entrada (com id: substitui)
#   automacoes remover <id>
#   automacoes ligar <id> sim|nao
#   automacoes executar <id> [motivo]       roda as ações (o shell chama isto)
#   automacoes testar                       roda as ações de uma automação vinda pela entrada
#   automacoes dispositivos        JSON: [{tipo, nome}] (som, controle, pendrive, outro)
#   automacoes baterias            JSON: [{nome, bateria}] dos aparelhos sem fio
import datetime
import json
import os
import re
import secrets
import shlex
import subprocess
import sys
import time
