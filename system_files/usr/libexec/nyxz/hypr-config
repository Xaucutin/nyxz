#!/usr/bin/bash
# Garante a configuração do Hyprland da Nyxz antes da sessão abrir.
# - Cria o que faltar (usuários novos ou antigos).
# - Troca a configuração automática que o Hyprland gera quando não acha nenhuma.
# Assim ninguém precisa mexer em arquivo (regra "nada exige terminal").
set -u
modelo=/usr/share/nyxz/hypr
cfg="$HOME/.config/hypr"
mkdir -p "$cfg/nyxz"

if [ ! -f "$cfg/hyprland.lua" ] || grep -qi "autogenerated" "$cfg/hyprland.lua"; then
  if [ -f "$cfg/hyprland.lua" ]; then
    mv -f "$cfg/hyprland.lua" "$cfg/hyprland.lua.automatico.bak"
  fi
  cp "$modelo/hyprland.lua" "$cfg/hyprland.lua"
fi
[ -f "$cfg/user.lua" ]      || cp "$modelo/user.lua" "$cfg/user.lua"
[ -f "$cfg/nyxz/init.lua" ] || cp "$modelo/nyxz-init.lua" "$cfg/nyxz/init.lua"
exit 0
