def unidade_projeto(nome):
    return f"nyxz-projeto-{nome}"


def ambiente_projeto(pj):
    """Ambiente com os segredos do cofre (nunca gravados em arquivo) e as linguagens do mise."""
    env = dict(os.environ, PATH=f"{SHIMS}:{Path.home() / '.local/bin'}:{os.environ.get('PATH', '')}")
    for nome in pj.get("segredos", []):
        valor = cofre_ler(nome).strip()
        if valor:
            env[nome] = valor
    return env


def projetos_listar():
    lista = []
    for pj in ler_projetos():
        aberto = rodar(["systemctl", "--user", "is-active", "--quiet", unidade_projeto(pj["nome"])])[0] == 0
        lista.append({**pj, "aberto": aberto, "existe": Path(pj["pasta"]).is_dir(),
                      "git": (Path(pj["pasta"]) / ".git").exists(),
                      "protegido": (Path(pj["pasta"]) / ".git/hooks/pre-commit").exists()})
    print(json.dumps(lista, ensure_ascii=False))


def projetos_adicionar(nome, pasta):
    if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{0,40}", nome):
        print("Nome inválido (minúsculas, números, - e _).", file=sys.stderr)
        return 1
    caminho = Path(os.path.expanduser(pasta)).resolve()
    if not caminho.is_dir():
        print(f"A pasta {caminho} não existe.", file=sys.stderr)
        return 1
    lista = [x for x in ler_projetos() if x["nome"] != nome]
    lista.append({"nome": nome, "pasta": str(caminho), "bancos": [], "comando": "", "urls": [], "segredos": []})
    gravar_projetos(lista)
    return 0


def projetos_configurar(nome, dados):
    lista = ler_projetos()
    for pj in lista:
        if pj["nome"] == nome:
            for chave in ("bancos", "comando", "urls", "segredos"):
                if chave in dados:
                    pj[chave] = dados[chave]
            gravar_projetos(lista)
            return 0
    return 1


def projetos_remover(nome):
    projetos_fechar(nome)
    gravar_projetos([x for x in ler_projetos() if x["nome"] != nome])
    return 0


def projetos_abrir(nome):
    pj = projeto(nome)
    if not pj:
        print(f"Projeto {nome} não encontrado.", file=sys.stderr)
        return 1
    for b in pj.get("bancos", []):
        rodar(["podman", "start", f"nyxz-{b}"])
    # VS Code só se estiver instalado (é opcional, como tudo na Nyxz)
    if shutil.which("code"):
        rodar(["setsid", "-f", "nyx", "run", "code", pj["pasta"]])
    if pj.get("comando"):
        rodar(["systemctl", "--user", "reset-failed", unidade_projeto(nome)])
        codigo, saida = rodar(["systemd-run", "--user", "--collect", f"--unit={unidade_projeto(nome)}",
                               f"--description=Sessão do projeto {nome} (Dev Hub)",
                               "/usr/libexec/nyxz/nyxz-dev", "projetos", "executar", nome])
        if codigo != 0:
            print(saida.strip(), file=sys.stderr)
    if pj.get("urls"):
        # Dá tempo do servidor de desenvolvimento subir antes de abrir o navegador
        rodar(["setsid", "-f", "sh", "-c", 'sleep 4; for u in "$@"; do xdg-open "$u"; done', "abrir", *pj["urls"]])
    return 0


def projetos_executar(nome):
    pj = projeto(nome)
    if not pj or not pj.get("comando"):
        return 1
    os.chdir(pj["pasta"])
    os.execvpe("sh", ["sh", "-c", pj["comando"]], ambiente_projeto(pj))


def projetos_shell(nome):
    pj = projeto(nome)
    if not pj:
