# Processos que costumam ser servidores de desenvolvimento (para "Abrir no navegador")
DEV = ("node", "bun", "deno", "python", "python3", "php", "ruby", "go", "java", "vite", "next-server", "caddy", "nginx", "httpd")


def portas():
    _, saida = rodar(["ss", "-ltnpH"])
    # Bancos do Dev Hub: a porta deles é atendida pelo ajudante de rede do Podman
    # (pasta/rootlessport); mostra o nome do banco e não oferece "Encerrar".
    bancos = {b["porta"]: b["nome"] for b in ler_bancos()}
    lista, vistos = [], set()
    for linha in saida.splitlines():
        partes = linha.split()
        if len(partes) < 4:
            continue
        local = partes[3]
        endereco, _, porta = local.rpartition(":")
        m = re.search(r'users:\(\("([^"]+)",pid=(\d+)', linha)
        proc, pid = (m.group(1), int(m.group(2))) if m else ("", 0)
        chave = (porta, pid)
        if chave in vistos:
            continue
        vistos.add(chave)
        numero = int(porta) if porta.isdigit() else 0
        podman = proc.startswith(("pasta", "rootlessport", "slirp4netns", "conmon"))
        if podman and numero in bancos:
            proc, pid = f"banco {bancos[numero]}", 0
        lista.append({
            "porta": numero,
            "endereco": endereco.strip("[]"),
            "processo": proc,
            "pid": pid,
            # Só os processos da própria conta aparecem com nome/pid (sem root)
            "meu": pid > 0 and not podman,
            "banco": numero in bancos and podman,
            "dev": proc in DEV or proc.startswith("node"),
        })
    lista.sort(key=lambda x: x["porta"])
    print(json.dumps(lista, ensure_ascii=False))


def encerrar(pid):
    try:
        os.kill(int(pid), signal.SIGTERM)
        return 0
    except (OSError, ValueError) as e:
        print(f"Não foi possível encerrar: {e}", file=sys.stderr)
        return 1


# ------------------------------------------------------------------ SSH

SSH = Path.home() / ".ssh"
SSH_CONFIG = SSH / "config"


def ssh_pasta():
    SSH.mkdir(mode=0o700, exist_ok=True)
    os.chmod(SSH, 0o700)


def ssh_blocos():
    """[(nomes, linhas)] do ~/.ssh/config; o que vem antes do 1º Host fica com nomes=None."""
    try:
        linhas = SSH_CONFIG.read_text(encoding="utf-8").splitlines()
    except OSError:
        return []
    blocos, atual = [], (None, [])
    for linha in linhas:
        partes = linha.strip().split(None, 1)
        if partes and partes[0].lower() == "host":
            blocos.append(atual)
            atual = (partes[1].split() if len(partes) > 1 else [], [linha])
        else:
            atual[1].append(linha)
    blocos.append(atual)
    return blocos


def ssh_hosts():
    hosts = []
    for nomes, linhas in ssh_blocos():
        if not nomes:
            continue
        props = {}
        for linha in linhas[1:]:
            partes = linha.strip().split(None, 1)
            if len(partes) == 2 and not partes[0].startswith("#"):
                props[partes[0].lower()] = partes[1]
        for nome in nomes:
            if any(c in nome for c in "*?!"):
                continue   # padrões (Host *) não são destinos
            hosts.append({"nome": nome, "endereco": props.get("hostname", nome),
                          "usuario": props.get("user", ""), "porta": props.get("port", "22"),
                          "chave": props.get("identityfile", "")})
    print(json.dumps(hosts, ensure_ascii=False))


def ssh_adicionar(nome, endereco, usuario, porta, chave=""):
    if not re.fullmatch(r"[A-Za-z0-9._-]{1,64}", nome):
        print("Nome inválido: use letras, números, ponto, - e _.", file=sys.stderr)
        return 1
    if any(nome in (n or []) for n, _ in ssh_blocos()):
        print(f"Já existe um host chamado {nome}.", file=sys.stderr)
        return 1
    ssh_pasta()
    bloco = [f"\nHost {nome}", f"    HostName {endereco}"]
    if usuario:
        bloco.append(f"    User {usuario}")
    if porta and porta != "22":
        bloco.append(f"    Port {porta}")
    if chave:
        bloco.append(f"    IdentityFile {chave}")
    with open(SSH_CONFIG, "a", encoding="utf-8") as f:
        f.write("\n".join(bloco) + "\n")
    os.chmod(SSH_CONFIG, 0o600)
    return 0


def ssh_remover(nome):
    blocos = ssh_blocos()
    novo = []
    for nomes, linhas in blocos:
        if nomes == [nome]:
            continue
        novo.extend(linhas)
    SSH_CONFIG.write_text("\n".join(novo).strip("\n") + "\n", encoding="utf-8")
    return 0


def ssh_chaves():
    chaves = []
    for pub in sorted(SSH.glob("*.pub")) if SSH.exists() else []:
        codigo, saida = rodar(["ssh-keygen", "-lf", str(pub)])
        partes = saida.split()
        chaves.append({
            "nome": pub.stem,
            "arquivo": str(pub.with_suffix("")),
            "impressao": partes[1] if codigo == 0 and len(partes) > 1 else "",
            "tipo": partes[-1].strip("()") if codigo == 0 and partes else "",
            "publica": pub.read_text(encoding="utf-8", errors="replace").strip(),
        })
    print(json.dumps(chaves, ensure_ascii=False))


def ssh_gerar(nome, comentario):
    if not re.fullmatch(r"[A-Za-z0-9._-]{1,64}", nome):
        print("Nome inválido.", file=sys.stderr)
        return 1
    ssh_pasta()
    destino = SSH / nome
    if destino.exists():
        print(f"Já existe uma chave chamada {nome}.", file=sys.stderr)
        return 1
    codigo, saida = rodar(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", comentario, "-f", str(destino)])
    if codigo != 0:
        print(saida, file=sys.stderr)
    return codigo


def ssh_tuneis():
    _, saida = rodar(["pgrep", "-af", "ssh -N .*-L"])
    tuneis = []
    for linha in saida.splitlines():
        m = re.search(r"^(\d+) .*-L 127\.0\.0\.1:(\d+):localhost:(\d+) (\S+)$", linha)
        if m:
            tuneis.append({"pid": int(m.group(1)), "local": int(m.group(2)),
                           "remota": int(m.group(3)), "host": m.group(4)})
    print(json.dumps(tuneis, ensure_ascii=False))


def ssh_tunel(host, local, remota):
    if not porta_livre(int(local)):
        print(f"A porta {local} já está em uso aqui.", file=sys.stderr)
        return 1
    # BatchMode: túnel só com chave (sem perguntar senha num processo invisível)
    p = subprocess.Popen(["ssh", "-N", "-o", "ExitOnForwardFailure=yes", "-o", "BatchMode=yes",
                          "-o", "ServerAliveInterval=30",
                          "-L", f"127.0.0.1:{int(local)}:localhost:{int(remota)}", host],
                         stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True, start_new_session=True)
    time.sleep(3)
    if p.poll() is not None:
        erro = (p.stderr.read() or "").strip().splitlines()
        print("O túnel não abriu: " + (erro[-1] if erro else "verifique o host e a chave."), file=sys.stderr)
        return 1
    return 0


def ssh_servidor(acao):
    # O Fedora pode ouvir a porta 22 pelo sshd.socket (o serviço só sobe na 1ª conexão):
    # "ligado" = qualquer um dos dois ativo; ligar/desligar mexe nos dois.
    if acao == "estado":
        ativo = any(rodar(["systemctl", "is-active", "--quiet", u])[0] == 0 for u in ("sshd.service", "sshd.socket"))
        print(json.dumps({"ativo": ativo}))
        return 0
    if acao == "ligar":
        codigo, saida = rodar(["pkexec", "systemctl", "enable", "--now", "sshd.service"])
    else:
        codigo, saida = rodar(["pkexec", "systemctl", "disable", "--now", "sshd.socket", "sshd.service"])
    if codigo != 0:
        print("Não foi possível mudar o servidor SSH (senha cancelada?).", file=sys.stderr)
    return codigo


