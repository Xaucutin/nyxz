        "porta": 5432, "dados": "/var/lib/postgresql/data",
        "env": lambda u, s, n: {"POSTGRES_USER": u, "POSTGRES_PASSWORD": s, "POSTGRES_DB": n},
        "conexao": "postgresql://{u}:{s}@localhost:{p}/{n}",
    },
    "mariadb": {
        "nome": "MariaDB", "imagem": "docker.io/library/mariadb", "versoes": ["11", "10.11"],
        "porta": 3306, "dados": "/var/lib/mysql",
        "env": lambda u, s, n: {"MARIADB_ROOT_PASSWORD": s, "MARIADB_USER": u, "MARIADB_PASSWORD": s, "MARIADB_DATABASE": n},
        "conexao": "mysql://{u}:{s}@localhost:{p}/{n}",
    },
    "mysql": {
        "nome": "MySQL", "imagem": "docker.io/library/mysql", "versoes": ["8.4", "8.0"],
        "porta": 3306, "dados": "/var/lib/mysql",
        "env": lambda u, s, n: {"MYSQL_ROOT_PASSWORD": s, "MYSQL_USER": u, "MYSQL_PASSWORD": s, "MYSQL_DATABASE": n},
        "conexao": "mysql://{u}:{s}@localhost:{p}/{n}",
    },
    "redis": {
        "nome": "Redis", "imagem": "docker.io/library/redis", "versoes": ["7", "8"],
        "porta": 6379, "dados": "/data",
        "env": lambda u, s, n: {},
        "comando": lambda s: ["redis-server", "--appendonly", "yes", "--requirepass", s],
