COMUNS = {
    ".gitignore": "node_modules/\n.venv/\n__pycache__/\n.env\n",
    ".env.example": "# O Dev Hub injeta estas variáveis ao rodar (o token fica no cofre).\nDISCORD_TOKEN=\nDISCORD_GUILD_ID=\n",
}


def meta_bot(pasta):
    try:
        return json.loads((pasta / ".nyxz-bot.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None


def discord_bots():
    lista = []
    for pasta in sorted(BOTS.iterdir()) if BOTS.exists() else []:
        m = meta_bot(pasta)
        if m:
            lista.append({**m, "pasta": str(pasta), "temToken": bool(cofre_ler(f"discord-{m['nome']}")),
                          "rodando": bot_rodando(m["nome"])})
    print(json.dumps(lista, ensure_ascii=False))


def discord_criar(nome, ling):
    if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{0,40}", nome) or ling not in ("js", "py"):
        print("Nome inválido (minúsculas, números, - e _) ou linguagem diferente de js/py.", file=sys.stderr)
        return 1
    pasta = BOTS / nome
    if pasta.exists():
        print(f"Já existe uma pasta {pasta}.", file=sys.stderr)
        return 1
    pasta.mkdir(parents=True)
    for nome_arq, conteudo in {**(MODELO_JS if ling == "js" else MODELO_PY), **COMUNS}.items():
        (pasta / nome_arq).write_text(conteudo.replace("%(nome)s", nome), encoding="utf-8")
    (pasta / ".nyxz-bot.json").write_text(json.dumps({"nome": nome, "linguagem": ling, "servidorTeste": ""}), encoding="utf-8")
    rodar(["git", "init", "-q", str(pasta)])
    return 0


def discord_servidor_teste(nome, ident):
    pasta = BOTS / nome
    m = meta_bot(pasta)
    if not m or not re.fullmatch(r"[0-9]{0,22}", ident):
        return 1
    m["servidorTeste"] = ident
    (pasta / ".nyxz-bot.json").write_text(json.dumps(m), encoding="utf-8")
    return 0


def arquivos_vigiados(pasta, ling):
    ext = ".js" if ling == "js" else ".py"
    for raiz, dirs, nomes in os.walk(pasta):
        dirs[:] = [d for d in dirs if d not in ("node_modules", ".venv", "__pycache__", ".git")]
        for n in nomes:
            if n.endswith(ext) or n in ("package.json", "requirements.txt"):
                yield os.path.join(raiz, n)


def assinatura(pasta, ling):
    total = 0.0
    for a in arquivos_vigiados(pasta, ling):
        try:
            total += os.stat(a).st_mtime
        except OSError:
            pass
    return total


def discord_rodar(nome):
    import threading
    pasta = BOTS / nome
    m = meta_bot(pasta)
    if not m:
        fim(False, f"Bot {nome} não encontrado.")
    token = cofre_ler(f"discord-{nome}")
    if not token:
        fim(False, "Guarde o token do bot primeiro (botão Token).")
    env = dict(os.environ, DISCORD_TOKEN=token.strip(), PYTHONUNBUFFERED="1",
               PATH=f"{SHIMS}:{os.environ.get('PATH', '')}")
    if m.get("servidorTeste"):
        env["DISCORD_GUILD_ID"] = m["servidorTeste"]
    ling = m["linguagem"]
    if ling == "js":
        if not shutil.which("node", path=env["PATH"]):
            fim(False, "Instale o Node.js em Configurações → Apps e componentes → Desenvolvimento.")
        if not (pasta / "node_modules").exists():
            passo("Instalando as dependências (npm install)")
            if subprocess.run(["npm", "install", "--no-fund", "--no-audit"], cwd=pasta, env=env,
                              stdout=sys.stdout, stderr=subprocess.STDOUT).returncode != 0:
                fim(False, "O npm install falhou.")
        cmd = ["node", "index.js"]
    else:
        python = shutil.which("python3", path=env["PATH"]) or "/usr/bin/python3"
        venv = pasta / ".venv"
        if not venv.exists():
            passo("Criando o ambiente Python e instalando o discord.py")
            if subprocess.run([python, "-m", "venv", str(venv)], cwd=pasta).returncode != 0 or \
               subprocess.run([str(venv / "bin/pip"), "install", "-q", "-r", "requirements.txt"], cwd=pasta, env=env,
                              stdout=sys.stdout, stderr=subprocess.STDOUT).returncode != 0:
                fim(False, "A instalação do discord.py falhou.")
        cmd = [str(venv / "bin/python"), "bot.py"]

    filho = {"p": None}

    def parar(*_):
        if filho["p"] and filho["p"].poll() is None:
            filho["p"].terminate()
        sys.exit(0)
    signal.signal(signal.SIGTERM, parar)
    signal.signal(signal.SIGINT, parar)

    def ler(p):
        for linha in p.stdout:
            print(f"LOG|{linha.rstrip()}", flush=True)

    while True:
        passo("Rodando (salve um arquivo para reiniciar)")
        filho["p"] = subprocess.Popen(cmd, cwd=pasta, env=env, stdout=subprocess.PIPE,
                                      stderr=subprocess.STDOUT, text=True)
        threading.Thread(target=ler, args=(filho["p"],), daemon=True).start()
        marca = assinatura(pasta, ling)
        avisou = False
        while True:
            time.sleep(1)
            if assinatura(pasta, ling) != marca:
                passo("Arquivo salvo: reiniciando o bot")
                if filho["p"].poll() is None:
                    filho["p"].terminate()
                    try:
                        filho["p"].wait(5)
                    except subprocess.TimeoutExpired:
                        filho["p"].kill()
                break
            if filho["p"].poll() is not None and not avisou:
                passo(f"O bot parou (código {filho['p'].returncode}). Salve um arquivo para tentar de novo.")
                avisou = True


def unidade_bot(nome):
    return f"nyxz-bot-{nome}"


def bot_rodando(nome):
    return rodar(["systemctl", "--user", "is-active", "--quiet", unidade_bot(nome)])[0] == 0


def discord_iniciar(nome):
    # Serviço transitório do usuário: o bot continua rodando com o Dev Hub fechado.
    rodar(["systemctl", "--user", "reset-failed", unidade_bot(nome)])
    codigo, saida = rodar(["systemd-run", "--user", "--collect", f"--unit={unidade_bot(nome)}",
                           f"--description=Bot do Discord {nome} (Dev Hub)",
                           "/usr/libexec/nyxz/nyxz-dev", "discord", "rodar", nome])
    if codigo != 0:
        print(saida.strip(), file=sys.stderr)
    return codigo


def discord_parar(nome):
    return rodar(["systemctl", "--user", "stop", unidade_bot(nome)])[0]


def discord_logs(nome):
    _, saida = rodar(["journalctl", "--user", "-u", unidade_bot(nome), "-n", "200", "-o", "cat", "--no-pager"])
    for linha in saida.splitlines():
        tipo, _, resto = linha.partition("|")
        if tipo == "LOG":
            print(resto)
        elif tipo == "PASSO":
            print("— " + resto)
        elif tipo == "FIM":
            print("— " + resto.replace("erro|", "Erro: "))
        else:
            print(linha)


def discord_webhook(nome_cofre):
    import urllib.request
    url = cofre_ler(nome_cofre).strip()
    if not url.startswith("https://discord.com/api/webhooks/") and not url.startswith("https://discordapp.com/api/webhooks/"):
        print(f"Guarde a URL do webhook no cofre com o nome {nome_cofre}.", file=sys.stderr)
        return 1
    corpo = sys.stdin.read().encode("utf-8")
    req = urllib.request.Request(url, data=corpo, method="POST",
                                 headers={"Content-Type": "application/json", "User-Agent": "Nyxz-DevHub"})
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            print(f"Enviado (HTTP {r.status}).")
            return 0
    except Exception as e:   # erro do Discord vem com explicação no corpo
        detalhe = getattr(e, "read", lambda: b"")().decode("utf-8", "replace")[:300]
        print(f"O Discord recusou: {e} {detalhe}", file=sys.stderr)
        return 1


