#!/usr/bin/python3 -I
"""nyxz-dev — o que o Dev Hub faz por baixo (também dá para usar no terminal).

Bancos locais (estilo XAMPP), cada um num container Podman da sua conta (sem senha
de administrador), com os dados num volume próprio:
  nyxz-dev bancos tipos                                   JSON: tipos e versões
  nyxz-dev bancos listar                                  JSON: bancos e se estão ligados
  nyxz-dev bancos criar <tipo> <versão> <nome> <porta> <usuário> <senha>
  nyxz-dev bancos iniciar|parar|logs <nome>
  nyxz-dev bancos remover <nome> [--apagar-dados]

Portas em uso:
  nyxz-dev portas                                         JSON: porta, endereço, processo, pid
  nyxz-dev portas encerrar <pid>

Cofre de segredos (chaveiro do sistema, Secret Service):
  nyxz-dev cofre listar                                   JSON: nomes (nunca os valores)
  nyxz-dev cofre guardar <nome>                           valor pela entrada padrão
  nyxz-dev cofre ler <nome>
  nyxz-dev cofre remover <nome>

SSH:
  nyxz-dev ssh hosts                                      JSON: hosts do ~/.ssh/config
  nyxz-dev ssh adicionar <nome> <endereço> <usuário> <porta> [chave]
  nyxz-dev ssh remover <nome>
  nyxz-dev ssh chaves                                     JSON: chaves em ~/.ssh
  nyxz-dev ssh gerar <nome> <comentário>                  ed25519
  nyxz-dev ssh tuneis                                     JSON: túneis abertos
  nyxz-dev ssh tunel <host> <porta-local> <porta-remota>
  nyxz-dev ssh fechar <pid>
  nyxz-dev ssh servidor estado|ligar|desligar             servidor SSH deste computador

Progresso (criar): linhas "PASSO|texto" e "LOG|texto"; última: "FIM|ok" ou "FIM|erro|mensagem".
"""
import json
import os
import shutil
import time
import re
import signal
import socket
import subprocess
import sys
from pathlib import Path

PASTA = Path.home() / ".config/nyxz/dev"
BANCOS = PASTA / "bancos.json"
ROTULO = "nyxz.banco"

# tipo -> imagem, versões, porta interna, pasta de dados, ambiente e conexão
TIPOS = {
    "postgres": {
