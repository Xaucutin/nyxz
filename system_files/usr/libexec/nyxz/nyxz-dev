GANCHO = """#!/bin/sh
# Nyxz: bloqueia o commit se algum segredo do cofre aparecer no que vai ser commitado.
# Para pular uma vez (sabendo o que está fazendo): git commit --no-verify
exec /usr/libexec/nyxz/nyxz-dev segredos verificar
"""


def projetos_proteger(nome):
    pj = projeto(nome)
    if not pj:
        return 1
    pasta = Path(pj["pasta"])
    if not (pasta / ".git").exists():
        print("A pasta não é um repositório Git (rode git init primeiro).", file=sys.stderr)
        return 1
    gancho = pasta / ".git/hooks/pre-commit"
    gancho.parent.mkdir(parents=True, exist_ok=True)
    if gancho.exists() and "nyxz-dev segredos" not in gancho.read_text(errors="replace"):
        print("O projeto já tem um pre-commit próprio; ele não foi trocado.", file=sys.stderr)
        return 1
    gancho.write_text(GANCHO, encoding="utf-8")
    os.chmod(gancho, 0o755)
    exemplo = pasta / ".env.example"
    if pj.get("segredos") and not exemplo.exists():
        exemplo.write_text("# Os valores ficam no cofre da Nyxz (Dev Hub → Cofre); o Dev Hub injeta ao rodar.\n" +
                           "".join(f"{n}=\n" for n in pj["segredos"]), encoding="utf-8")
    gi = pasta / ".gitignore"
    linhas = gi.read_text(encoding="utf-8").splitlines() if gi.exists() else []
    if ".env" not in linhas:
        gi.write_text("\n".join(linhas + [".env"]).strip() + "\n", encoding="utf-8")
    return 0


def segredos_verificar():
    codigo, diff = rodar(["git", "diff", "--cached", "-U0", "--no-color"])
    if codigo != 0:
        return 0
    adicionadas = "\n".join(l[1:] for l in diff.splitlines() if l.startswith("+") and not l.startswith("+++"))
    if not adicionadas:
        return 0
    achados = []
    for tipo in ("segredo", "banco"):
        for nome in cofre_nomes(tipo):
            valor = cofre_ler(nome, tipo=tipo).strip()
            if len(valor) >= 6 and valor in adicionadas:
                achados.append(nome)
    if achados:
        print("Commit bloqueado pela Nyxz: o valor destes segredos do cofre aparece no que vai ser commitado:", file=sys.stderr)
        for n in sorted(set(achados)):
            print(f"  - {n}", file=sys.stderr)
        print("Tire o valor do código (use a variável de ambiente) e tente de novo.", file=sys.stderr)
        return 1
    return 0


