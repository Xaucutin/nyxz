def passo(t):
    print(f"PASSO|{t}", flush=True)


def fim(ok=True, msg=""):
    print("FIM|ok" if ok else f"FIM|erro|{msg}", flush=True)
    sys.exit(0 if ok else 1)


def rodar(cmd, mostrar=False):
    if not mostrar:
        r = subprocess.run(cmd, capture_output=True, text=True)
        return r.returncode, r.stdout + r.stderr
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    for linha in p.stdout:
        linha = linha.strip()
        if linha:
            print(f"LOG|{linha}", flush=True)
    return p.wait(), ""


def ler_bancos():
    try:
        return json.loads(BANCOS.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return []


def gravar_bancos(lista):
    PASTA.mkdir(parents=True, exist_ok=True)
    BANCOS.write_text(json.dumps(lista, ensure_ascii=False, indent=2), encoding="utf-8")
    os.chmod(BANCOS, 0o600)   # tem senhas: só o dono lê (até o cofre chegar)


def porta_livre(porta):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            s.bind(("127.0.0.1", porta))
            return True
        except OSError:
            return False


# ------------------------------------------------------------------ cofre

def cofre_ok():
    return shutil.which("secret-tool") is not None


def cofre_guardar(nome, valor, tipo="segredo"):
    if not cofre_ok():
        return False
    r = subprocess.run(["secret-tool", "store", "--label", f"Nyxz: {nome}", "app", "nyxz", "tipo", tipo, "nome", nome],
                       input=valor, text=True, capture_output=True)
    return r.returncode == 0


def cofre_ler(nome, tipo="segredo"):
    if not cofre_ok():
        return ""
    codigo, saida = rodar(["secret-tool", "lookup", "app", "nyxz", "tipo", tipo, "nome", nome])
    return saida if codigo == 0 else ""


def cofre_remover(nome, tipo="segredo"):
    if cofre_ok():
        rodar(["secret-tool", "clear", "app", "nyxz", "tipo", tipo, "nome", nome])


def cofre_nomes(tipo="segredo"):
    if not cofre_ok():
        return []
    r = subprocess.run(["secret-tool", "search", "--all", "app", "nyxz", "tipo", tipo], capture_output=True, text=True)
    return sorted({l.split(" = ", 1)[1] for l in (r.stdout + "\n" + r.stderr).splitlines()
                   if l.startswith("attribute.nome = ")})


def cofre_listar():
    if not cofre_ok():
        print(json.dumps({"disponivel": False, "itens": []}))
        return
    r = subprocess.run(["secret-tool", "search", "--all", "app", "nyxz", "tipo", "segredo"],
                       capture_output=True, text=True)
    itens, atual = [], {}
    # Junta stdout e stderr: o secret-tool divide os campos entre os dois. O valor
    # ("secret = ...") é ignorado: esta lista nunca mostra segredos.
    for linha in (r.stdout + "\n" + r.stderr).splitlines():
        if linha.startswith("["):
            if atual.get("nome"):
                itens.append(atual)
            atual = {}
        elif linha.startswith("attribute.nome = "):
            atual["nome"] = linha.split(" = ", 1)[1]
        elif linha.startswith("modified = "):
            atual["alterado"] = linha.split(" = ", 1)[1]
    if atual.get("nome"):
        itens.append(atual)
    vistos, unicos = set(), []
    for i in sorted(itens, key=lambda x: x["nome"].lower()):
        if i["nome"] not in vistos:
            vistos.add(i["nome"])
            unicos.append(i)
    print(json.dumps({"disponivel": True, "itens": unicos}, ensure_ascii=False))


def conexao(b):
    t = TIPOS[b["tipo"]]
    return t["conexao"].format(u=b["usuario"], s=b["senha"], p=b["porta"], n=b["nome"])


# ------------------------------------------------------------------ bancos

def bancos_listar():
    _, saida = rodar(["podman", "ps", "-a", "--filter", f"label={ROTULO}", "--format", "json"])
    try:
        estado = {c["Names"][0]: c.get("State", "") for c in json.loads(saida or "[]")}
    except (ValueError, KeyError, IndexError):
        estado = {}
    lista = []
    for b in ler_bancos():
        if b.get("noCofre"):
            b["senha"] = cofre_ler(b["nome"], tipo="banco")
        st = estado.get("nyxz-" + b["nome"], "ausente")
        lista.append({**b, "tipoNome": TIPOS[b["tipo"]]["nome"], "estado": st,
                      "ligado": st == "running", "conexao": conexao(b)})
    print(json.dumps(lista, ensure_ascii=False))


def bancos_criar(tipo, versao, nome, porta, usuario, senha):
    if tipo not in TIPOS:
        fim(False, f"Tipo desconhecido: {tipo}")
    if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{0,30}", nome):
        fim(False, "Nome inválido: use letras minúsculas, números, - e _.")
    if any(b["nome"] == nome for b in ler_bancos()):
        fim(False, f"Já existe um banco chamado {nome}.")
    porta = int(porta)
    if not porta_livre(porta):
        fim(False, f"A porta {porta} já está em uso. Escolha outra.")
    t = TIPOS[tipo]
    imagem = f"{t['imagem']}:{versao}"
    passo(f"Baixando {t['nome']} {versao} (só na primeira vez)")
    codigo, _ = rodar(["podman", "pull", imagem], mostrar=True)
    if codigo != 0:
        fim(False, "Não foi possível baixar a imagem. Verifique a internet.")
    passo("Criando o banco")
    cmd = ["podman", "create", "--name", f"nyxz-{nome}", "--label", f"{ROTULO}={tipo}",
           "-p", f"127.0.0.1:{porta}:{t['porta']}", "-v", f"nyxz-{nome}:{t['dados']}"]
    for k, v in t["env"](usuario, senha, nome).items():
        cmd += ["-e", f"{k}={v}"]
    cmd.append(imagem)
    if "comando" in t:
        cmd += t["comando"](senha)
    codigo, saida = rodar(cmd)
    if codigo != 0:
        fim(False, "Não foi possível criar o container: " + saida.strip().splitlines()[-1][:200])
    lista = ler_bancos()
    no_cofre = cofre_guardar(nome, senha, tipo="banco")
    lista.append({"nome": nome, "tipo": tipo, "versao": versao, "porta": porta,
                  "usuario": usuario, "senha": "" if no_cofre else senha, "noCofre": no_cofre})
    gravar_bancos(lista)
    passo("Ligando")
    codigo, saida = rodar(["podman", "start", f"nyxz-{nome}"])
    if codigo != 0:
        fim(False, "Criado, mas não ligou: " + saida.strip()[-200:])
    fim()


def bancos_acao(acao, nome, apagar=False):
    c = f"nyxz-{nome}"
    if acao == "iniciar":
        codigo, saida = rodar(["podman", "start", c])
    elif acao == "parar":
        codigo, saida = rodar(["podman", "stop", "-t", "10", c])
    elif acao == "logs":
        codigo, saida = rodar(["podman", "logs", "--tail", "200", c])
        print(saida)
        return 0
    elif acao == "remover":
        rodar(["podman", "rm", "-f", c])
        if apagar:
            rodar(["podman", "volume", "rm", "-f", c])
        cofre_remover(nome, tipo="banco")
        gravar_bancos([b for b in ler_bancos() if b["nome"] != nome])
        return 0
    else:
        return 2
    if codigo != 0:
        print(saida.strip()[-300:], file=sys.stderr)
    return codigo


