CASA = Path.home()
CACHES = [
    ("npm", ".npm/_cacache"), ("pip", ".cache/pip"), ("pnpm", ".local/share/pnpm/store"),
    ("Yarn", ".cache/yarn"), ("Bun", ".bun/install/cache"), ("Cargo (Rust)", ".cargo/registry/cache"),
    ("Go", ".cache/go-build"), ("Gradle", ".gradle/caches"), ("mise (downloads)", ".local/share/mise/downloads"),
    ("Cache de shaders da Steam", ".local/share/Steam/steamapps/shadercache"),
    ("Cache de shaders da Steam (Flatpak)", ".var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/shadercache"),
    ("Lixeira", ".local/share/Trash"),
]
FORA = (".local", ".cache", ".var", ".npm", ".cargo", ".bun", ".gradle", ".config", ".mozilla")


def tamanho(caminho):
    r = subprocess.run(["du", "-sb", str(caminho)], capture_output=True, text=True)
    try:
        return int(r.stdout.split()[0])
    except (IndexError, ValueError):
        return 0


def node_modules_parados(dias):
    limite = time.time() - dias * 86400
    achados = []
    for raiz, dirs, _ in os.walk(CASA):
        rel = Path(raiz).relative_to(CASA)
        if rel.parts and rel.parts[0] in FORA:
            dirs[:] = []
            continue
        if "node_modules" in dirs:
            nm = Path(raiz) / "node_modules"
            # Projeto parado: nada na pasta (fora o node_modules) mudou há "dias" dias
            recente = 0
            for e in os.scandir(raiz):
                if e.name != "node_modules":
                    try:
                        recente = max(recente, e.stat(follow_symlinks=False).st_mtime)
                    except OSError:
                        pass
            if recente < limite:
                achados.append(nm)
            dirs.remove("node_modules")
        dirs[:] = [d for d in dirs if not d.startswith(".")]   # pastas ocultas ficam de fora
    return achados


def limpeza_itens(dias=30):
    itens = []
    for nm in node_modules_parados(dias):
        itens.append({"id": f"pasta:{nm}", "grupo": f"node_modules de projetos parados há {dias}+ dias",
                      "nome": str(nm.parent.relative_to(CASA)), "bytes": tamanho(nm)})
    for nome, rel in CACHES:
        c = CASA / rel
        if c.exists():
            b = tamanho(c)
            if b > 0:
                itens.append({"id": f"pasta:{c}", "grupo": "Caches", "nome": nome, "bytes": b})
    if shutil.which("podman"):
        _, saida = rodar(["podman", "system", "df", "--format", "json"])
        try:
            for linha in json.loads(saida or "[]"):
                if linha.get("Type") == "Images" and int(linha.get("Reclaimable") or 0) > 0:
                    itens.append({"id": "podman", "grupo": "Podman", "nome": "Imagens sem uso (os bancos do Dev Hub ficam)",
                                  "bytes": int(linha["Reclaimable"])})
        except (ValueError, TypeError, KeyError):
            pass
    if shutil.which("flatpak"):
        _, saida = rodar(["flatpak", "uninstall", "--user", "--unused", "--noninteractive", "--assumeno"])
        if "Nothing unused" not in saida and re.search(r"\d+\.\s", saida):
            itens.append({"id": "flatpak", "grupo": "Flatpak", "nome": "Runtimes que nenhum app usa mais", "bytes": -1})
    return itens


def limpeza_analisar(dias):
    itens = limpeza_itens(int(dias))
    print(json.dumps({"itens": itens, "total": sum(i["bytes"] for i in itens if i["bytes"] > 0)}, ensure_ascii=False))


def pode_apagar(alvo):
    """Só node_modules dentro da pasta pessoal (fora das ocultas) ou um dos caches conhecidos."""
    alvo = alvo.resolve()
    if alvo in [(CASA / rel).resolve() for _, rel in CACHES]:
        return True
    if alvo.name != "node_modules" or CASA not in alvo.parents:
        return False
    rel = alvo.relative_to(CASA)
    return not any(parte.startswith(".") for parte in rel.parts) and "node_modules" not in rel.parts[:-1]


def limpeza_apagar(ids):
    # Nada de caminhos quaisquer vindos de fora: cada id é validado aqui
    liberado = 0
    for ident in ids:
        if ident.startswith("pasta:"):
            alvo = Path(ident[6:])
            if not alvo.exists() or not pode_apagar(alvo):
                continue
            b = tamanho(alvo)
            if alvo.name == "Trash":
                for sub in ("files", "info", "expunged"):
                    shutil.rmtree(alvo / sub, ignore_errors=True)
            else:
                shutil.rmtree(alvo, ignore_errors=True)
            liberado += b
        elif ident == "podman":
            antes = tamanho(CASA / ".local/share/containers/storage")
            rodar(["podman", "image", "prune", "-a", "-f"])
            liberado += max(0, antes - tamanho(CASA / ".local/share/containers/storage"))
        elif ident == "flatpak":
            rodar(["flatpak", "uninstall", "--user", "--unused", "-y", "--noninteractive"])
    print(json.dumps({"liberado": liberado}))
    return 0


