#!/usr/bin/python3 -I
"""Componentes opcionais da Nyxz (ARQUITETURA.md, seções 1 e 2.7).

- Apps Flatpak vão para a conta do usuário (sem senha de administrador).
- Apps nativos (rpm) entram numa imagem local personalizada:
  FROM <imagem base da Nyxz> + os pacotes escolhidos, construída com podman
  como root e ativada com `bootc switch --transport containers-storage`.
  Vale no próximo boot. O timer de atualização reconstrói quando a base muda.

Comandos (a saída é lida pelo Nyxz Setup e pelas Configurações):
  componentes estado                         -> JSON
  componentes usuario --instalar a,b --remover c
  componentes sistema a,b,c                  (root) lista COMPLETA de itens nativos desejados
  componentes reconstruir                    (root) usado pelo timer de atualização
Linhas de progresso: "PASSO|texto"; última linha: "FIM|ok" ou "FIM|erro|mensagem".
"""
import json
import os
import re
import select
import subprocess
import sys
import time
from pathlib import Path

CATALOGO = Path("/usr/share/nyxz/catalogo.json")
ESCOLHA_SISTEMA = Path("/etc/nyxz/componentes-sistema.json")
PASTA_IMAGEM = Path("/var/lib/nyxz/imagem")
IMAGEM_LOCAL = "localhost/nyxz-local:latest"
FLATHUB = "https://dl.flathub.org/repo/flathub.flatpakrepo"


def passo(texto):
    print(f"PASSO|{texto}", flush=True)


def fim(ok=True, msg=""):
    print("FIM|ok" if ok else f"FIM|erro|{msg}", flush=True)
    sys.exit(0 if ok else 1)


def rodar(cmd, mostrar=False, parado=900):
    """Roda um comando. Com mostrar=True, repassa a saída como linhas "LOG|...".

    flatpak, podman e dnf redesenham o progresso com \\r: cada trecho entre \\r ou \\n
    vira uma linha, e o progresso repetido é enviado no máximo 2 vezes por segundo.
    Se o comando ficar `parado` segundos sem escrever nada (download travado), ele
    é encerrado e o código de saída vira 124, em vez de a tela ficar presa para sempre.
    """
    if not mostrar:
        r = subprocess.run(cmd, capture_output=True, text=True)
        return r.returncode, r.stdout
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    fd = p.stdout.fileno()
    resto, ultimo_envio, ultima_saida = b"", 0.0, time.monotonic()
    while True:
        prontos, _, _ = select.select([fd], [], [], 5)
        agora = time.monotonic()
        if not prontos:
            if agora - ultima_saida > parado:
                print(f"LOG|Sem resposta há {parado // 60} minutos; cancelando.", flush=True)
                p.kill()
                p.wait()
                return 124, ""
            continue
        bloco = os.read(fd, 65536)
        if not bloco:
            break
        ultima_saida = agora
        dados = resto + bloco
        fim_ = 0
        for m in re.finditer(rb"([^\r\n]*)([\r\n])", dados):
            fim_ = m.end()
            linha = m.group(1).decode("utf-8", "replace").strip()
            # Linhas terminadas em \n sempre passam; redesenhos (\r), no máximo 2/s.
            if linha and (m.group(2) == b"\n" or agora - ultimo_envio >= 0.5):
                print(f"LOG|{linha}", flush=True)
                ultimo_envio = agora
        resto = dados[fim_:]
    linha = resto.decode("utf-8", "replace").strip()
    if linha:
        print(f"LOG|{linha}", flush=True)
    return p.wait(), ""


def script(it, acao):
    """Comando de um extra da conta do usuário: <script> <ação> [argumentos do catálogo]."""
    return [it["script"], acao, *it.get("args", [])]


def catalogo():
    return json.loads(CATALOGO.read_text(encoding="utf-8"))


def imagem_base():
    try:
        return Path("/usr/share/nyxz/imagem-base").read_text().strip()
    except OSError:
        return "ghcr.io/xaucutin/nyxz:44"


def implantacoes():
    codigo, saida = rodar(["rpm-ostree", "status", "--json"])
    if codigo != 0:
        return None, False
    lista = json.loads(saida).get("deployments", [])
    iboot = next((i for i, d in enumerate(lista) if d.get("booted")), -1)
    ref = lista[iboot].get("container-image-reference", "") if iboot >= 0 else ""
    return ref, iboot > 0


def flatpaks_instalados():
    _, saida = rodar(["flatpak", "list", "--app", "--columns=application"])
    return set(saida.split())


def estado():
    cat = catalogo()
    fps = flatpaks_instalados()
    itens = {}
    for it in cat["itens"]:
        if it["tipo"] == "flatpak":
            itens[it["id"]] = it["flatpak"] in fps
        elif it["tipo"] == "usuario":
            codigo, _ = rodar(script(it, "estado"))
            itens[it["id"]] = codigo == 0
        else:
            codigo, _ = rodar(["rpm", "-q", *it["pacotes"]])
            itens[it["id"]] = codigo == 0
    ref, pendente = implantacoes()
    escolhidos = []
    if ESCOLHA_SISTEMA.exists():
        escolhidos = json.loads(ESCOLHA_SISTEMA.read_text()).get("itens", [])
    print(json.dumps({
        "itens": itens,
        "escolhidosSistema": escolhidos,
        "imagemLocal": "containers-storage" in (ref or ""),
        "reinicioPendente": pendente,
    }))


def usuario(instalar, remover):
    cat = {i["id"]: i for i in catalogo()["itens"]}
    rodar(["flatpak", "remote-add", "--user", "--if-not-exists", "flathub", FLATHUB])
    falhas = []
    # Extras ("usuario") dependem de um Flatpak (ex.: Spicetify → Spotify): o que eles
    # pedem entra na instalação e eles rodam depois dos Flatpaks.
    for iid in list(instalar):
        it = cat.get(iid)
        if it and it["tipo"] == "usuario":
            for req in it.get("requer", []):
                if req not in instalar and cat.get(req, {}).get("tipo") == "flatpak" \
                        and cat[req]["flatpak"] not in flatpaks_instalados():
                    instalar.insert(0, req)
    flatpaks = [cat[i] for i in instalar if i in cat and cat[i]["tipo"] == "flatpak"]
    extras = [cat[i] for i in instalar if i in cat and cat[i]["tipo"] == "usuario"]
    for it in flatpaks:
        passo(f"Instalando {it['nome']}")
        codigo, _ = rodar(["flatpak", "install", "--user", "-y", "--noninteractive", "flathub", it["flatpak"]], mostrar=True)
        if codigo != 0:
            falhas.append(it["nome"])
    for it in extras:
        passo(f"Instalando {it['nome']}")
        codigo, _ = rodar(script(it, "instalar"), mostrar=True)
        if codigo != 0:
            falhas.append(it["nome"])
    # Sem o Flatpak de que dependem, os extras saem junto (ex.: tirar o Spotify tira o Spicetify).
    for it in cat.values():
        if it["tipo"] == "usuario" and it["id"] not in remover \
                and any(r in remover for r in it.get("requer", [])) \
                and rodar(script(it, "estado"))[0] == 0:
            remover.append(it["id"])
    # Remoção na ordem contrária: extras antes dos Flatpaks de que dependem.
    for tipo in ("usuario", "flatpak"):
        for iid in remover:
            it = cat.get(iid)
            if not it or it["tipo"] != tipo:
                continue
            passo(f"Removendo {it['nome']}")
            if tipo == "usuario":
                rodar(script(it, "remover"), mostrar=True)
            else:
                rodar(["flatpak", "uninstall", "--user", "-y", "--noninteractive", it["flatpak"]], mostrar=True)
    if falhas:
        fim(False, "Não foi possível instalar: " + ", ".join(falhas))
    fim()


def construir(ids, puxar="newer"):
    cat = catalogo()
    itens = [i for i in cat["itens"] if i["id"] in ids and i["tipo"] == "rpm"]
    pacotes = sorted({p for i in itens for p in i["pacotes"]})
    repos = sorted({cat["repositorios"][r] for i in itens for r in i.get("repos", [])})
    liga = " ".join(f"sed -i 's/^enabled=0/enabled=1/' /etc/yum.repos.d/{r};" for r in repos)
    desliga = " ".join(f"sed -i 's/^enabled=1/enabled=0/' /etc/yum.repos.d/{r};" for r in repos)
    # Serviços que o app precisa (ex.: lactd do LACT), ligados dentro da imagem.
    servicos = sorted({s for i in itens for s in i.get("servicos", [])})
    liga_servicos = f"systemctl enable {' '.join(servicos)}; " if servicos else ""
    PASTA_IMAGEM.mkdir(parents=True, exist_ok=True)
    (PASTA_IMAGEM / "Containerfile").write_text(
        "# Gerado por /usr/libexec/nyxz/componentes. Não edite: use Configurações → Apps e componentes.\n"
        f"FROM {imagem_base()}\n"
        f"RUN set -e; {liga} "
        f"dnf -y install --setopt=install_weak_deps=False {' '.join(pacotes)}; "
        f"{liga_servicos}{desliga} dnf clean all; rm -rf /var/log/dnf5.log* /tmp/* /var/cache/*\n"
        f'LABEL org.nyxz.componentes="{",".join(i["id"] for i in itens)}"\n',
        encoding="utf-8",
    )
    passo("Montando a imagem personalizada (baixa a base e os apps; pode levar alguns minutos)")
    codigo, _ = rodar(["podman", "build", f"--pull={puxar}", "-t", IMAGEM_LOCAL, str(PASTA_IMAGEM)], mostrar=True)
    if codigo != 0:
        fim(False, "A montagem da imagem falhou. Verifique a internet e tente de novo.")
    ref, _ = implantacoes()
    passo("Preparando a nova versão para o próximo boot")
    if "containers-storage" in (ref or ""):
        codigo, _ = rodar(["bootc", "upgrade"], mostrar=True)
    else:
        codigo, _ = rodar(["bootc", "switch", "--transport", "containers-storage", IMAGEM_LOCAL], mostrar=True)
    if codigo != 0:
        fim(False, "Não foi possível preparar a nova versão do sistema.")
    rodar(["podman", "image", "prune", "-f"])


def sistema(ids):
    if os.geteuid() != 0:
        fim(False, "Precisa de permissão de administrador.")
    cat = catalogo()
    validos = [i["id"] for i in cat["itens"] if i["tipo"] == "rpm" and i["id"] in ids]
    ESCOLHA_SISTEMA.parent.mkdir(parents=True, exist_ok=True)
    ESCOLHA_SISTEMA.write_text(json.dumps({"itens": validos}, ensure_ascii=False))
    ref, _ = implantacoes()
    if not validos:
        if "containers-storage" in (ref or ""):
            passo("Voltando para a imagem padrão da Nyxz (sem apps nativos extras)")
            codigo, _ = rodar(["bootc", "switch", imagem_base()], mostrar=True)
            if codigo != 0:
                fim(False, "Não foi possível voltar para a imagem padrão.")
            rodar(["podman", "rmi", "-f", IMAGEM_LOCAL])
        fim()
    construir(validos)
    fim()


def reconstruir():
    if os.geteuid() != 0:
        fim(False, "Precisa de permissão de administrador.")
    ids = []
    if ESCOLHA_SISTEMA.exists():
        ids = json.loads(ESCOLHA_SISTEMA.read_text()).get("itens", [])
    if not ids:
        codigo, _ = rodar(["bootc", "upgrade", "--quiet"], mostrar=True)
        fim(codigo == 0, "bootc upgrade falhou")
    construir(ids, puxar="always")
    fim()


def lista(arg):
    return [x for x in (arg or "").split(",") if x]


if __name__ == "__main__":
    args = sys.argv[1:]
    if not args or args[0] == "estado":
        estado()
    elif args[0] == "usuario":
        inst = lista(args[args.index("--instalar") + 1]) if "--instalar" in args else []
        rem = lista(args[args.index("--remover") + 1]) if "--remover" in args else []
        usuario(inst, rem)
    elif args[0] == "sistema":
        sistema(lista(args[1] if len(args) > 1 else ""))
    elif args[0] == "reconstruir":
        reconstruir()
    else:
        print(__doc__)
        sys.exit(1)
