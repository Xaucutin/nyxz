[Unit]
Description=Nyxz: celular integrado (KDE Connect)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# O caminho do kdeconnectd muda entre versões do pacote
ExecStart=/bin/sh -c 'exec "$(command -v kdeconnectd || echo /usr/libexec/kdeconnectd)"'
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
