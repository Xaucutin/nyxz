[Unit]
Description=Nyxz: procura o Windows (dual boot) e as partições NTFS
After=local-fs.target systemd-timedated.service
ConditionPathExists=/sys/firmware/efi

[Service]
Type=oneshot
ExecStart=/usr/libexec/nyxz/nyxz-dualboot-root verificar
StandardOutput=null

[Install]
WantedBy=multi-user.target
