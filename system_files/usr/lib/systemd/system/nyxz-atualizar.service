[Unit]
Description=Nyxz: baixar a atualização do sistema (aplica só no próximo boot)
Documentation=https://github.com/Xaucutin/nyxz
Wants=network-online.target
After=network-online.target
ConditionACPower=true

[Service]
Type=oneshot
# Só baixa e prepara a nova versão. Nunca reinicia o PC sozinho
# (o bootc-fetch-apply-updates.timer padrão reinicia, por isso fica desligado).
Environment=NYXZ_AUTOMATICO=1
ExecStart=/usr/libexec/nyxz/atualizar
Nice=19
IOSchedulingClass=idle
